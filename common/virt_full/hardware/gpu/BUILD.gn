import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")
import("//device/qemu/common/virt_full/device.gni")

assert(target_cpu == "arm64" || target_cpu == "x86_64",
       "device/qemu/common/virt_full/hardware/gpu only supports arm64 and x86_64")

virt_lib = "lib64"

qemu_mesa_libs_dir = "$root_build_dir/packages/phone/qemu_mesa"

# Build the portable QEMU GL stack from the historical OHOS Mesa baseline
# with the upstream va_list logger fix.  The checked-in 64-bit driver predates
# that fix and crashes RenderService while eglInitialize() selects virtio_gpu.
qemu_llvm_product = "arm64_virt"
if (target_cpu == "x86_64") {
  qemu_llvm_product = "x86_64_virt"
}

action("qemu_mesa_build") {
  script = "//third_party/mesa3d/build_qemu_mesa_llvm.py"
  inputs = [
    "//device/qemu/common/virt_full/hardware/gpu/build_qemu_mesa.py",
    "//third_party/mesa3d/build_qemu_mesa_llvm.py",
    "//third_party/mesa3d/qemu_mesa_llvm_artifacts.py",
    "//third_party/mesa3d/qemu_llvm_build_identity.json",
    "//third_party/mesa3d/qemu_llvm/634e042f0532266d934ad4c6ee9cc52a85695f49f8079e7303ec57f1a0981cdd/$qemu_llvm_product/manifest.json",
    "//third_party/mesa3d/qemu_llvm/634e042f0532266d934ad4c6ee9cc52a85695f49f8079e7303ec57f1a0981cdd/$qemu_llvm_product/lib/libllvm.a",
    "//third_party/mesa3d/qemu_build_id/apply_mesa_build_id.py",
    "//third_party/mesa3d/qemu_build_id/0001-bound-ELF-note-payloads-before-reading-or-advancing.patch",
    "//third_party/mesa3d/qemu_bounds_and_guard/apply_mesa_bounds_and_guard.py",
    "//third_party/mesa3d/qemu_bounds_and_guard/0001-clip-llvmpipe-partial-4x4-edge-stamps.patch",
    "//third_party/mesa3d/qemu_bounds_and_guard/0002-reserve-kms-dumb-bo-tail-guard-vma.patch",
    "mesa_kms_mapping/apply_mesa_kms_mapping.py",
    "mesa_kms_mapping/0001-serialize-displaytarget-mapping.patch",
    "mesa_kms_mapping/0002-serialize-import-reference-and-final-destroy.patch",
  ]
  deps = [
    "//third_party/expat:expat",
    "//third_party/libdrm:libdrm",
  ]
  external_deps = [
    "graphic_surface:surface",
    "hilog:libhilog",
  ]
  outputs = [
    "$qemu_mesa_libs_dir/mesa-llvm-build-provenance.json",
    "$qemu_mesa_libs_dir/libEGL.so.1.0.0",
    "$qemu_mesa_libs_dir/libgbm.so.1.0.0",
    "$qemu_mesa_libs_dir/libGLESv1_CM.so.1.1.0",
    "$qemu_mesa_libs_dir/libGLESv2.so.2.0.0",
    "$qemu_mesa_libs_dir/libglapi.so.0.0.0",
    "$qemu_mesa_libs_dir/kms_swrast_dri.so",
  ]
  args = [ rebase_path(root_build_dir) ]
}

ohos_prebuilt_shared_library("libglapi.so.0.0.0") {
  source = "$qemu_mesa_libs_dir/libglapi.so.0.0.0"
  deps = [ ":qemu_mesa_build" ]
  install_images = [ "system" ]
  module_install_dir = "$virt_lib"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
  symlink_target_name = [
    "libglapi.so",
    "libglapi.so.0",
  ]
}

ohos_prebuilt_shared_library("libEGL.so.1.0.0") {
  source = "$qemu_mesa_libs_dir/libEGL.so.1.0.0"
  deps = [ ":qemu_mesa_build" ]
  install_images = [ "system" ]
  module_install_dir = "$virt_lib"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
  symlink_target_name = [
    "libEGL_impl.so",
  ]
}

ohos_prebuilt_shared_library("libgbm.so.1.0.0") {
  source = "$qemu_mesa_libs_dir/libgbm.so.1.0.0"
  deps = [ ":qemu_mesa_build" ]
  install_images = [ "system" ]
  module_install_dir = "$virt_lib"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
  symlink_target_name = [
    "libgbm.so",
    "libgbm.so.1",
  ]
}

ohos_prebuilt_shared_library("kms_swrast_dri.so") {
  source = "$qemu_mesa_libs_dir/kms_swrast_dri.so"
  deps = [ ":qemu_mesa_build" ]
  install_images = [ "system" ]
  module_install_dir = "$virt_lib"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
  symlink_target_name = [
    "swrast_dri.so",
    "virtio_gpu_dri.so",
  ]
}

ohos_prebuilt_shared_library("libGLESv1_CM.so.1.1.0") {
  source = "$qemu_mesa_libs_dir/libGLESv1_CM.so.1.1.0"
  deps = [ ":qemu_mesa_build" ]
  install_images = [ "system" ]
  module_install_dir = "$virt_lib"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
  symlink_target_name = [
    "libGLESv1_impl.so",
  ]
}

ohos_prebuilt_shared_library("libGLESv2.so.2.0.0") {
  source = "$qemu_mesa_libs_dir/libGLESv2.so.2.0.0"
  deps = [ ":qemu_mesa_build" ]
  install_images = [ "system" ]
  module_install_dir = "$virt_lib"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
  symlink_target_name = [
    "libGLESv2_impl.so",
    "libGLESv3_impl.so",
  ]
}

if (target_cpu == "x86_64") {
  # x86_64 runtime still dlopen()s these legacy Mesa impl names.
  # The regular prebuilt symlink metadata is not materializing into the
  # final image, so install explicit compatibility copies here.
  ohos_copy("libEGL_impl_compat") {
    sources = [ "$qemu_mesa_libs_dir/libEGL.so.1.0.0" ]
    deps = [ ":qemu_mesa_build" ]
    outputs = [ "${target_out_dir}/libEGL_impl.so" ]
    module_install_name = "libEGL_impl.so"
    module_type = "lib"
    prebuilt = true
    install_enable = true
    enable_strip = false
    copy_linkable_file = true
    install_images = [ "system" ]
    module_install_dir = "$virt_lib"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
  }

  ohos_copy("libGLESv3_impl_compat") {
    sources = [ "$qemu_mesa_libs_dir/libGLESv2.so.2.0.0" ]
    deps = [ ":qemu_mesa_build" ]
    outputs = [ "${target_out_dir}/libGLESv3_impl.so" ]
    module_install_name = "libGLESv3_impl.so"
    module_type = "lib"
    prebuilt = true
    install_enable = true
    enable_strip = false
    copy_linkable_file = true
    install_images = [ "system" ]
    module_install_dir = "$virt_lib"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
  }

  # virtio_gpu_dri.so disabled due to render_service SIGSEGV crash
  # The driver contains a bug in ohos_logger that causes crashes
  # ohos_prebuilt_shared_library("virtio_gpu_dri.so") {
  #   source = "${target_cpu}/virtio_gpu_dri.so"
  #   install_images = [ "system" ]
  #   module_install_dir = "$virt_lib"
  #   subsystem_name = virt_subsystem_name
  #   part_name = virt_part_name
  #   install_enable = true
  # }

  ohos_prebuilt_shared_library("swrast_dri.so") {
    source = "${target_cpu}/swrast_dri.so"
    install_images = [ "system" ]
    module_install_dir = "$virt_lib"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_shared_library("libVkLayer_MESA_overlay.so") {
    source = "${target_cpu}/libVkLayer_MESA_overlay.so"
    install_images = [ "system" ]
    module_install_dir = "$virt_lib"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_shared_library("libVkLayer_MESA_device_select.so") {
    source = "${target_cpu}/libVkLayer_MESA_device_select.so"
    install_images = [ "system" ]
    module_install_dir = "$virt_lib"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_shared_library("libvulkan_virtio.so") {
    source = "${target_cpu}/libvulkan_virtio.so"
    install_images = [ "system" ]
    module_install_dir = "$virt_lib"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_etc("IMG.icd") {
    source = "etc/OpenCL/vendors/IMG.icd"
    install_images = [ "system" ]
    module_install_dir = "etc/OpenCL/vendors"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_etc("VkLayer_MESA_overlay.json") {
    source = "etc/vulkan/explicit_layer.d/VkLayer_MESA_overlay.json"
    install_images = [ "system" ]
    module_install_dir = "etc/vulkan/explicit_layer.d"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_etc("VkLayer_MESA_device_select.json") {
    source = "etc/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json"
    install_images = [ "system" ]
    module_install_dir = "etc/vulkan/implicit_layer.d"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }

  ohos_prebuilt_etc("icdconf.json") {
    source = "etc/vulkan/icd.d/icdconf.json"
    install_images = [ "system" ]
    module_install_dir = "etc/vulkan/icd.d"
    subsystem_name = virt_subsystem_name
    part_name = virt_part_name
    install_enable = true
  }
}

ohos_prebuilt_etc("00-mesa-defaults.conf") {
  source = "drirc.d/00-mesa-defaults.conf"
  install_images = [ "system" ]
  module_install_dir = "etc/drirc.d"
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
  install_enable = true
}

group("virtio") {
  deps = [
    ":libEGL.so.1.0.0",
    ":libgbm.so.1.0.0",
    ":libglapi.so.0.0.0",
    ":kms_swrast_dri.so",
    ":libGLESv1_CM.so.1.1.0",
    ":libGLESv2.so.2.0.0",
    ":00-mesa-defaults.conf",
  ]
  if (target_cpu == "x86_64") {
    deps += [
      ":libEGL_impl_compat",
      ":libGLESv3_impl_compat",
      # ":virtio_gpu_dri.so",  # disabled due to render_service crashes
    ]
  }
}
